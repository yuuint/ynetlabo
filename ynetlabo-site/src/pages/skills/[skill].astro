---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideToc from "../../components/GuideToc.astro";
import CopyCode from "../../components/CopyCode.astro";
import { SITE, SKILLS, SOCIAL } from "../../consts";
import { formatDate } from "../../utils";

export async function getStaticPaths() {
  const skills = await getCollection("skills");
  return skills.map((entry) => ({
    params: { skill: entry.id },
    props: { entry, skills },
  }));
}

const { entry, skills } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const origin = (Astro.site ?? new URL(SITE.url)).origin;
const pageUrl = new URL(`/skills/${entry.id}`, Astro.site ?? SITE.url).href;
const repoDir = `${SKILLS.repo}/tree/main/skills/${d.name}`;
const fileHref = (path: string) => `${SKILLS.repo}/blob/main/skills/${d.name}/${path}`;

/** 同じカテゴリの他のスキル */
const related = skills
  .filter((s) => s.id !== entry.id && s.data.category === d.category)
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 3);

const articleLd = {
  "@type": "TechArticle",
  "@id": `${pageUrl}#skill`,
  headline: `${d.name} — ${d.title}`,
  description: d.description,
  inLanguage: "ja",
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  dateModified: d.updated.toISOString(),
  author: { "@type": "Person", name: "yuuki", url: SOCIAL.github },
  publisher: { "@id": `${origin}/#org` },
  license: "https://opensource.org/licenses/MIT",
  keywords: ["Claude", "Agent Skills", "Claude Code", d.category].join(", "),
};

const breadcrumbLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${origin}/` },
    { "@type": "ListItem", position: 2, name: "スキル", item: `${origin}/skills/` },
    { "@type": "ListItem", position: 3, name: d.title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={`${d.title}（${d.name}）`}
  description={d.description}
  jsonLd={[articleLd, breadcrumbLd]}
>
  <article class="skill">
    <header class="skill-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="パンくず">
          <a href="/">ホーム</a><span>/</span><a href="/skills/">スキル</a>
        </nav>

        <div class="skill-head__tags">
          <span class="chip">{d.category}</span>
          <code class="skill-head__name">{d.name}</code>
        </div>

        <h1 class="skill-head__title">{d.title}</h1>
        <p class="skill-head__desc">{d.description}</p>

        <div class="skill-head__meta">
          <span>最終更新 <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></span>
          <span>MIT ライセンス</span>
        </div>

        <div class="skill-head__links">
          <a class="btn btn-accent btn-sm" href={repoDir} target="_blank" rel="noopener noreferrer">
            GitHub で見る
          </a>
          <a class="btn btn-ghost btn-sm" href="#install">インストール</a>
        </div>
      </div>
    </header>

    <div class="wrap skill-body">
      <div class="skill-toc-mobile">
        <GuideToc headings={headings} collapsible />
      </div>

      <div class="skill-main">
        {
          d.trigger && (
            <details class="card trigger">
              <summary class="trigger__summary">Claude がこのスキルを読み込む条件</summary>
              <p class="trigger__text">{d.trigger}</p>
              <p class="trigger__note">
                <code>SKILL.md</code> の frontmatter にある <code>description</code>{" "}
                です。依頼の内容がここに書かれた状況に当てはまると、Claude が自分でこのスキルを読み込みます。
              </p>
            </details>
          )
        }

        <div class="prose skill-prose">
          <Content />
        </div>

        <section class="install" id="install">
          <h2 class="install__title">インストール</h2>
          <CopyCode
            label="個人用（全プロジェクトで使う）"
            code={`git clone ${SKILLS.clone}\ncp -r claude-skills/skills/${d.name} ~/.claude/skills/`}
          />
          <CopyCode
            label="プロジェクト単位（チームで共有する）"
            code={`cp -r claude-skills/skills/${d.name} <your-project>/.claude/skills/`}
          />
        </section>

        {
          d.files.length > 0 && (
            <section class="files">
              <h2 class="files__title">同梱ファイル</h2>
              <p class="files__lead">
                <code>SKILL.md</code> から参照される参考資料・テンプレート・スクリプトです。ディレクトリごとコピーしてください。
              </p>
              <ul class="files__list">
                {d.files.map((f) => (
                  <li>
                    <a href={fileHref(f)} target="_blank" rel="noopener noreferrer">
                      <code>{f}</code>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="skill-aside">
        <GuideToc headings={headings} />
      </aside>
    </div>

    <div class="wrap skill-foot">
      {
        related.length > 0 && (
          <section class="related">
            <h2 class="related__title">{d.category}の他のスキル</h2>
            <ul class="related__list">
              {related.map((s) => (
                <li>
                  <a class="card card-link related__card" href={`/skills/${s.id}/`}>
                    <code class="related__name">{s.data.name}</code>
                    <span class="related__heading">{s.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      <a href="/skills/" class="btn btn-ghost">← スキル一覧へ</a>
    </div>
  </article>
</BaseLayout>

<style>
  /* ----- ヘッダ ----- */
  .skill-head {
    padding-top: 2.5rem;
    padding-bottom: 2.25rem;
    background: var(--color-mist);
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }
  .crumbs a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--color-ink);
  }
  .skill-head__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }
  .skill-head__name {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-accent-ink);
    word-break: break-all;
  }
  .skill-head__title {
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.1rem);
    line-height: 1.35;
  }
  .skill-head__desc {
    margin-top: 1rem;
    max-width: 46rem;
    color: var(--color-body);
    font-size: 0.94rem;
  }
  .skill-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.1rem;
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .skill-head__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .btn-sm {
    padding: 0.5rem 1.1rem;
    font-size: 0.84rem;
  }

  /* ----- 本文 + 追従目次 ----- */
  .skill-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 3rem;
    align-items: start;
    padding-block: 2.5rem 3rem;
  }
  .skill-main {
    min-width: 0;
  }
  .skill-aside {
    position: sticky;
    /* sticky ヘッダ 4.25rem の下 */
    top: 5.5rem;
  }
  .skill-toc-mobile {
    display: none;
  }

  /* 読み込み条件（折りたたみ） */
  .trigger {
    padding: 1.1rem 1.4rem;
    margin-bottom: 2.5rem;
  }
  .trigger__summary {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-ink);
    cursor: pointer;
  }
  .trigger__text {
    margin-top: 0.9rem;
    font-size: 0.86rem;
    line-height: 1.9;
    color: var(--color-body);
  }
  .trigger__note {
    margin-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .trigger code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.88em;
    color: var(--color-accent-ink);
  }

  /* 本文の先頭見出しは h2 から始まるので、上の余白だけ詰める */
  .skill-prose :global(h2:first-child) {
    margin-top: 0;
  }

  /* ----- インストール / 同梱ファイル ----- */
  .install,
  .files {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .install__title,
  .files__title {
    font-size: 1.15rem;
    margin-bottom: 1.1rem;
  }
  .install :global(.copycode + .copycode) {
    margin-top: 1.25rem;
  }
  .files__lead {
    font-size: 0.86rem;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  .files__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.4rem 1.25rem;
  }
  .files__list a {
    font-size: 0.84rem;
    color: var(--color-accent-ink);
    text-decoration: none;
  }
  .files__list a:hover {
    text-decoration: underline;
  }
  .files__list code,
  .install code {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  }

  /* ----- フッタ ----- */
  .skill-foot {
    padding-bottom: 4rem;
  }
  .related {
    margin-bottom: 2rem;
  }
  .related__title {
    font-size: 1rem;
    margin-bottom: 1rem;
  }
  .related__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .related__card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.25rem;
    height: 100%;
    text-decoration: none;
  }
  .related__name {
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--color-accent-ink);
    word-break: break-all;
  }
  .related__heading {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-ink);
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .skill-body {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .skill-aside {
      display: none;
    }
    .skill-toc-mobile {
      display: block;
    }
    .related__list {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .files__list {
      grid-template-columns: 1fr;
    }
  }
</style>
