---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { PROJECTS } from "../../consts";
import { formatDate } from "../../utils";

// 試作中（draft）のガイドは開発時だけ一覧に出す
const guides = (await getCollection("guide"))
  .filter((g) => import.meta.env.DEV || !g.data.draft)
  .sort((a, b) => a.data.app.localeCompare(b.data.app));

const cards = guides.map((g) => ({
  entry: g,
  project: PROJECTS.find((p) => p.name === g.data.app),
}));
---

<BaseLayout
  title="使い方ガイド"
  description="Y.NetLabo のアプリの使い方ガイド。画面図つきで、機能ごとの操作を説明します。"
>
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Guide</span>
        <h1 class="section-title">使い方ガイド</h1>
        <p class="section-sub">アプリごとの操作を、画面図つきで説明します。</p>
      </div>

      {
        cards.length === 0 ? (
          <p class="empty">公開中のガイドはまだありません。</p>
        ) : (
          <div class="guide-grid">
            {cards.map(({ entry, project }) => (
              <a
                class="card card-link guide-card"
                href={`/guide/${entry.id}`}
                style={`--brand:${project?.accent ?? "var(--color-accent)"}`}
              >
                <div class="guide-card__top">
                  {project?.icon ? (
                    <img
                      class="guide-card__icon"
                      src={project.icon}
                      alt=""
                      width="56"
                      height="56"
                      loading="lazy"
                    />
                  ) : (
                    <span class="guide-card__dot" />
                  )}
                  <div class="guide-card__headings">
                    <h2 class="guide-card__name">{entry.data.app}</h2>
                    {project && <span class="guide-card__tag">{project.tagline}</span>}
                  </div>
                </div>
                <p class="guide-card__desc">{entry.data.description}</p>
                <div class="guide-card__foot">
                  <time datetime={entry.data.updated.toISOString()}>
                    最終更新 {formatDate(entry.data.updated)}
                  </time>
                  {entry.data.draft && <span class="chip">試作中</span>}
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 4rem;
  }
  .section-head {
    margin-bottom: 2.5rem;
  }
  .section-title {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
    margin-top: 0.6rem;
  }
  .section-sub {
    margin-top: 0.6rem;
    color: var(--color-muted);
  }
  .empty {
    color: var(--color-muted);
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .guide-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    text-decoration: none;
  }
  .guide-card__top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .guide-card__icon {
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    border-radius: 22.5%;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--brand) 20%, transparent),
      var(--shadow-sm);
  }
  .guide-card__dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--brand);
  }
  .guide-card__headings {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .guide-card__name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.1;
  }
  .guide-card__tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-muted);
  }
  .guide-card__desc {
    font-size: 0.9rem;
    color: var(--color-body);
    flex: 1;
  }
  .guide-card__foot {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
    font-size: 0.78rem;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .guide-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .guide-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
