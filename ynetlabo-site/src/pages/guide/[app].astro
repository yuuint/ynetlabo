---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuideToc from "../../components/GuideToc.astro";
import GuideDiagrams from "../../components/GuideDiagrams.astro";
import { PROJECTS, SITE } from "../../consts";
import { formatDate } from "../../utils";

export async function getStaticPaths() {
  const guides = await getCollection("guide");
  return guides.map((entry) => ({
    params: { app: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const project = PROJECTS.find((p) => p.name === d.app);
const origin = (Astro.site ?? new URL(SITE.url)).origin;
const pageUrl = new URL(`/guide/${entry.id}`, Astro.site ?? SITE.url).href;

const storeLinks = [
  project?.appStore && { label: "App Store", href: project.appStore },
  project?.googlePlay && { label: "Google Play", href: project.googlePlay },
  project?.site && { label: "Web版", href: project.site },
].filter(Boolean) as { label: string; href: string }[];

const breadcrumbLd = {
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: `${origin}/` },
    { "@type": "ListItem", position: 2, name: "使い方ガイド", item: `${origin}/guide/` },
    { "@type": "ListItem", position: 3, name: d.title, item: pageUrl },
  ],
};
---

<BaseLayout
  title={d.title}
  description={d.description}
  noindex={d.draft}
  jsonLd={d.draft ? undefined : breadcrumbLd}
>
  <article class="guide">
    <header class="guide-head">
      <div class="wrap">
        <nav class="crumbs" aria-label="パンくず">
          <a href="/">ホーム</a><span>/</span><a href="/guide/">使い方ガイド</a>
        </nav>

        <div class="guide-head__row" style={`--brand:${project?.accent ?? "var(--color-accent)"}`}>
          {
            project?.icon && (
              <img
                class="guide-head__icon"
                src={project.icon}
                alt={`${project.name} アプリアイコン`}
                width="64"
                height="64"
              />
            )
          }
          <div>
            <h1 class="guide-head__title">{d.title}</h1>
            {project && <p class="guide-head__tag">{project.tagline}</p>}
          </div>
        </div>

        <p class="guide-head__desc">{d.description}</p>

        <div class="guide-head__meta">
          <span>最終更新 <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></span>
          {d.draft && <span class="chip">試作中（未公開）</span>}
        </div>

        {
          storeLinks.length > 0 && (
            <div class="guide-head__links">
              {storeLinks.map((l) => (
                <a class="btn btn-ghost btn-sm" href={l.href} target="_blank" rel="noopener noreferrer">
                  {l.label}
                </a>
              ))}
            </div>
          )
        }
      </div>
    </header>

    <div class="wrap guide-body">
      <div class="guide-toc-mobile">
        <GuideToc headings={headings} collapsible />
      </div>

      <div class="prose guide-prose">
        <Content />
        <GuideDiagrams />
      </div>

      <aside class="guide-aside">
        <GuideToc headings={headings} />
      </aside>
    </div>

    <div class="wrap guide-foot">
      <p class="guide-foot__note">
        解決しないときは<a href="/contact/">お問い合わせ</a>からご連絡ください。
      </p>
      <a href="/guide/" class="btn btn-ghost">← 使い方ガイド一覧へ</a>
    </div>
  </article>
</BaseLayout>

<style>
  /* ----- ヘッダ ----- */
  .guide-head {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
    background: var(--color-mist);
  }
  .crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }
  .crumbs a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--color-ink);
  }
  .guide-head__row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .guide-head__icon {
    width: 3.5rem;
    height: 3.5rem;
    flex-shrink: 0;
    border-radius: 22.5%;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent),
      var(--shadow-sm);
  }
  .guide-head__title {
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.1rem);
    line-height: 1.3;
  }
  .guide-head__tag {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-muted);
  }
  .guide-head__desc {
    margin-top: 1.1rem;
    max-width: 44rem;
    color: var(--color-body);
    font-size: 0.94rem;
  }
  .guide-head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .guide-head__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .btn-sm {
    padding: 0.5rem 1.1rem;
    font-size: 0.84rem;
  }

  /* ----- 本文 + 追従目次 ----- */
  .guide-body {
    display: grid;
    /* 本文は図が入るので記事(48rem)より広く取り、目次を右に固定する */
    grid-template-columns: minmax(0, 1fr) 15rem;
    gap: 3rem;
    align-items: start;
    padding-block: 3rem;
  }
  .guide-aside {
    position: sticky;
    /* sticky ヘッダ 4.25rem の下 */
    top: 5.5rem;
  }
  .guide-toc-mobile {
    display: none;
  }

  /* ----- フッタ ----- */
  .guide-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }
  .guide-foot__note {
    font-size: 0.88rem;
    color: var(--color-muted);
  }
  .guide-foot__note a {
    color: var(--color-accent-ink);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .guide-body {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .guide-aside {
      display: none;
    }
    .guide-toc-mobile {
      display: block;
    }
  }
</style>
