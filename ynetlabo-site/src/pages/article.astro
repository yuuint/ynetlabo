---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleTimeline from "../components/ArticleTimeline.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// build category list with counts
const counts = new Map<string, number>();
for (const p of posts)
  for (const c of p.data.categories) counts.set(c, (counts.get(c) ?? 0) + 1);
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title="記事"
  description="アプリ開発で得た知見と、つくったプロダクトの裏側の記録。設計をどう判断したか、AI コーディングツールを実務でどう使っているか、個人開発の試行錯誤をカテゴリ別にまとめています。"
>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow" lang="en">Notes</span>
      <h1 class="page-title">記事</h1>
      <p class="page-sub">
        アプリ開発で得た知見や、プロダクトの裏側を記録しています。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cat-filter">
        <button type="button" class="cat-pill active" data-cat="" aria-pressed="true">
          すべて ({posts.length})
        </button>
        {
          categories.map(([name, count]) => (
            <button type="button" class="cat-pill" data-cat={name} aria-pressed="false">
              {name} ({count})
            </button>
          ))
        }
      </div>

      <ArticleTimeline posts={posts} />
      <p class="no-results" hidden>このカテゴリの記事はありません。</p>
    </div>
  </section>

  <script>
    const pills = document.querySelectorAll<HTMLButtonElement>(".cat-pill");
    const rows = document.querySelectorAll<HTMLElement>(".tl-row");
    const months = document.querySelectorAll<HTMLElement>(".tl-month");
    const empty = document.querySelector<HTMLElement>(".no-results");

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const cat = pill.dataset.cat ?? "";
        pills.forEach((p) => {
          p.classList.toggle("active", p === pill);
          p.setAttribute("aria-pressed", String(p === pill));
        });

        let visible = 0;
        rows.forEach((row) => {
          const cats = (row.dataset.categories ?? "").split("|");
          const show = cat === "" || cats.includes(cat);
          row.hidden = !show;
          if (show) visible++;
        });
        // 記事が1本も残らない月は、月の見出しごと隠す
        months.forEach((m) => {
          m.hidden = !m.querySelector(".tl-row:not([hidden])");
        });

        if (empty) empty.hidden = visible !== 0;
      });
    });
  </script>
</BaseLayout>

<style>
  .page-head {
    padding-block: 3rem 1rem;
    background: transparent;
  }
  .page-title {
    font-size: clamp(1.8rem, 1.4rem + 2vw, 2.6rem);
    margin-top: 0.6rem;
  }
  .page-sub {
    margin-top: 0.75rem;
    color: var(--color-muted);
  }
  .section {
    padding-block: 3rem 4.5rem;
  }
  .cat-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 1.5rem + 1.5vw, 3rem);
  }
  .cat-pill {
    font-family: inherit;
    font-size: 0.84rem;
    font-weight: 500;
    padding: 0.45rem 1rem;
    border: none;
    border-radius: 999px;
    color: var(--color-ink-soft);
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    cursor: pointer;
    transition: box-shadow 0.2s ease, background-color 0.2s ease, color 0.15s ease;
  }
  .cat-pill:hover {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .cat-pill.active {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: none;
  }
  .no-results {
    color: var(--color-muted);
  }
  /* 狭い画面では絞り込みを1行にして横にスクロールさせ、記事を押し下げない */
  @media (max-width: 768px) {
    .cat-filter {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: -1.25rem;
      padding: 0.25rem 1.25rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .cat-filter::-webkit-scrollbar {
      display: none;
    }
    .cat-pill {
      flex: none;
      white-space: nowrap;
    }
  }
</style>
