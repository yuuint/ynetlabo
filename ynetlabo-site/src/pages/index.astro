---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { PROJECTS, PROFILE, SITE, SOCIAL } from "../consts";
import { articleHref } from "../utils";
import { APP_DETAILS } from "../data/apps";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts.slice(0, 3);

const origin = (Astro.site ?? new URL(SITE.url)).origin;

/** Anchor id for a product card, e.g. "wa/ri" -> "app-wa-ri" */
const appAnchor = (name: string) =>
  `app-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "")}`;

/** Hero proof points — kept in sync with PROJECTS so the count never goes stale */
const heroMeta = [
  `<strong>${PROJECTS.length}</strong> つのプロダクト`,
  "iOS / Android / Web / LINE",
  "すべて個人開発",
];
/** アプリ紹介ページ（/apps/<slug>）への内部リンク */
const appPageHref = (name: string) => {
  const d = APP_DETAILS.find((a) => a.project === name);
  return d ? `/apps/${d.slug}/` : undefined;
};

const appLd = PROJECTS.map((p) => ({
  "@type": "SoftwareApplication",
  name: p.name,
  description: p.description,
  applicationCategory: "MobileApplication",
  operatingSystem:
    [p.appStore && "iOS", p.googlePlay && "Android", p.site && "Web"]
      .filter(Boolean)
      .join(", ") || "Web",
  url: appPageHref(p.name) ? `${origin}${appPageHref(p.name)}` : p.site,
  sameAs: [p.site, p.appStore, p.googlePlay].filter(Boolean),
  offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
  publisher: { "@id": `${origin}/#org` },
}));
---

<BaseLayout jsonLd={appLd}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">App Development Lab</span>
        <h1 class="hero-title">
          シンプルなアプリに、<br />少しのペンギンを。
        </h1>
        <p class="hero-lead">{SITE.taglineEn}</p>
        <p class="hero-desc">{SITE.description}</p>
        <div class="hero-actions">
          <a href="#projects" class="btn btn-accent">プロダクトを見る</a>
          <a href="/article/" class="btn btn-ghost">記事を読む</a>
        </div>
        <ul class="hero-meta">
          {heroMeta.map((m) => <li set:html={m} />)}
        </ul>
      </div>

      <div class="hero-art">
        <img
          class="hero-penguin"
          src="/penguin-mark.png"
          alt=""
          width="235"
          height="235"
          aria-hidden="true"
        />
        <div class="shelf card">
          <span class="shelf-label">つくったアプリ</span>
          <ul class="shelf-grid">
            {
              PROJECTS.map((p, i) => (
                <li class="shelf-item" style={`--i:${i};--brand:${p.accent}`}>
                  <a
                    class="shelf-link"
                    href={`#${appAnchor(p.name)}`}
                    aria-label={`${p.name} — ${p.tagline}の詳細へ`}
                  >
                    <img
                      src={p.icon}
                      alt=""
                      width="56"
                      height="56"
                      decoding="async"
                    />
                    <span class="shelf-name">{p.name}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="shelf-cta" href="#projects">
            すべて見る<span class="shelf-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>

    <a class="scroll-cue" href="#about" aria-label="ページを下にスクロール">
      <span class="scroll-word">Scroll</span>
      <span class="scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about" class="section">
    <div class="wrap about-grid">
      <div>
        <span class="eyebrow">About</span>
        <h2 class="section-title">必要な機能だけを、丁寧に。</h2>
      </div>
      <div class="about-body">
        <p>
          Y.NetLabo は、企業ではなく「アプリ開発が好きな個人」のラボです。多機能で複雑なものより、<strong
            >迷わず使えるシンプルなアプリ</strong
          >を目指しています。
        </p>
        <p>
          不要な機能はそぎ落とし、本当に必要な機能だけを残す。そこに、ちょっとした遊び心としてペンギンのモチーフを添えています。使う人が「これで十分」と思える道具を作ることが、このラボのテーマです。
        </p>
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section id="projects" class="section section-mist">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Products</span>
        <h2 class="section-title">つくったアプリ</h2>
        <p class="section-sub">個人開発で世に出してきたプロダクトたち。</p>
      </div>

      <div class="project-grid">
        {
          PROJECTS.map((p) => (
            <article
              class="card project-card"
              id={appAnchor(p.name)}
              style={`--brand:${p.accent}`}
            >
              <div class="project-top">
                {p.icon ? (
                  <img
                    class="project-icon"
                    src={p.icon}
                    alt={`${p.name} アプリアイコン`}
                    width="56"
                    height="56"
                    loading="lazy"
                  />
                ) : (
                  <span class="project-dot" />
                )}
                <div class="project-headings">
                  <h3 class="project-name">{p.name}</h3>
                  <span class="project-tag">{p.tagline}</span>
                </div>
              </div>
              <p class="project-desc">{p.description}</p>
              <div class="project-links">
                {appPageHref(p.name) && (
                  <a class="plink plink-primary" href={appPageHref(p.name)}>
                    詳しく見る
                  </a>
                )}
                {p.site && (
                  <a class="plink" href={p.site} target="_blank" rel="noopener noreferrer">
                    公式サイト
                  </a>
                )}
                {p.appStore && (
                  <a class="plink" href={p.appStore} target="_blank" rel="noopener noreferrer">
                    App Store
                  </a>
                )}
                {p.googlePlay && (
                  <a class="plink" href={p.googlePlay} target="_blank" rel="noopener noreferrer">
                    Google Play
                  </a>
                )}
                {p.comingSoon?.map((store) => (
                  <span class="plink plink-soon" aria-disabled="true">
                    {store}
                    <span class="soon-tag">coming soon</span>
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LATEST ARTICLES ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head row">
        <div>
          <span class="eyebrow">Blog</span>
          <h2 class="section-title">最新の記事</h2>
        </div>
        <a href="/article/" class="link-arrow">すべての記事 →</a>
      </div>

      <div class="article-grid">
        {
          latest.map((post) => (
            <ArticleCard
              href={articleHref(post.data.wpId)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              categories={post.data.categories}
              heroImage={post.data.heroImage}
              heroAlt={post.data.heroAlt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROFILE ============ -->
  <section class="section section-mist">
    <div class="wrap profile-grid">
      <div class="profile-card card">
        <div class="profile-avatar">
          <img src={PROFILE.avatar} alt={PROFILE.name} width="460" height="460" />
        </div>
        <div>
          <h3 class="profile-name">{PROFILE.name}</h3>
          <p class="profile-role">{PROFILE.role}</p>
        </div>
      </div>
      <div class="profile-body">
        <span class="eyebrow">Profile</span>
        <h2 class="section-title">つくっている人</h2>
        <p>{PROFILE.bio}</p>
        <div class="stack">
          {PROFILE.stack.map((s) => <span class="chip">{s}</span>)}
        </div>
        <div class="profile-social">
          <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">GitHub</a>
          <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">X (Twitter)</a>
          <a href={SOCIAL.qiita} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Qiita</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="section">
    <div class="wrap">
      <div class="cta">
        <h2 class="cta-title">お気軽にご連絡ください</h2>
        <p class="cta-sub">
          アプリへのご感想・ご要望、不具合のご報告などお待ちしています。
        </p>
        <div class="cta-actions">
          <a href="/contact/" class="btn btn-accent">お問い合わせ</a>
          <a href={`mailto:${SITE.email}`} class="btn btn-ghost">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ----- section primitives ----- */
  .section {
    padding-block: 4.5rem;
    /* clear the sticky header when jumped to via an anchor */
    scroll-margin-top: 4.75rem;
  }
  .section-mist {
    background: var(--color-mist);
  }
  .section-head {
    margin-bottom: 2.5rem;
  }
  .section-head.row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-title {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem);
    margin-top: 0.6rem;
  }
  .section-sub {
    margin-top: 0.6rem;
    color: var(--color-muted);
  }
  .link-arrow {
    font-weight: 700;
    color: var(--color-accent-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  /* ----- hero ----- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }
  /* ambient light instead of hard blurred circles */
  .hero::before {
    --wash-warm: 249 115 22;
    --wash-cool: 56 189 248;
    --wash: 0.22;
    content: "";
    position: absolute;
    inset: -35% -20% 0;
    pointer-events: none;
    background:
      radial-gradient(
        42rem 30rem at 78% 42%,
        rgb(var(--wash-warm) / var(--wash)),
        rgb(var(--wash-warm) / 0) 68%
      ),
      radial-gradient(
        34rem 26rem at 6% 78%,
        rgb(var(--wash-cool) / calc(var(--wash) * 0.85)),
        rgb(var(--wash-cool) / 0) 70%
      );
    /* fade out before the section edge so overflow:hidden never cuts a seam */
    -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
  }
  :global([data-theme="dark"]) .hero::before {
    --wash: 0.15;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 2.5rem;
    padding-block: clamp(3.5rem, 2rem + 6vw, 6rem);
    padding-bottom: clamp(4.5rem, 2rem + 7vw, 7rem);
  }
  .hero-title {
    /* sized so 「シンプルなアプリに、」 stays on one line in the copy column */
    font-size: clamp(1.9rem, 1.15rem + 2.5vw, 3.25rem);
    line-height: 1.3;
    margin-top: 1rem;
  }
  .hero-lead {
    font-family: var(--font-display);
    color: var(--color-accent-ink);
    font-weight: 700;
    margin-top: 1rem;
    letter-spacing: 0.02em;
  }
  .hero-desc {
    margin-top: 1.25rem;
    max-width: 32rem;
    color: var(--color-muted);
  }
  .hero-actions {
    display: flex;
    gap: 0.9rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    margin-top: 1.75rem;
    font-size: 0.82rem;
    color: var(--color-muted);
    letter-spacing: 0.01em;
  }
  .hero-meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hero-meta li + li::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.65;
    margin-right: 0.7rem;
  }
  .hero-meta :global(strong) {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-ink);
  }

  /* ----- hero art: the app shelf ----- */
  .hero-art {
    position: relative;
    padding-top: 2.6rem;
  }
  /* the mascot peeks out from behind the shelf — "少しのペンギン" */
  .hero-penguin {
    position: absolute;
    top: 0;
    right: 3rem;
    z-index: 0;
    width: 7rem;
    height: auto;
    transform-origin: 50% 100%;
    filter: drop-shadow(0 10px 16px rgba(20, 33, 61, 0.2));
    animation:
      penguin-peek 0.7s 0.45s cubic-bezier(0.22, 1.2, 0.36, 1) both,
      penguin-bob 6s 1.3s ease-in-out infinite;
  }
  :global([data-theme="dark"]) .hero-penguin {
    filter: brightness(0) invert(1)
      drop-shadow(0 10px 18px rgba(0, 0, 0, 0.45));
  }
  @keyframes penguin-peek {
    from { transform: translateY(2.75rem) rotate(0deg); opacity: 0; }
    to { transform: translateY(0) rotate(-5deg); opacity: 1; }
  }
  @keyframes penguin-bob {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-5px) rotate(-2deg); }
  }

  .shelf {
    position: relative;
    z-index: 1;
    padding: 1.6rem 1.5rem 1.35rem;
    animation: shelf-rise 0.6s 0.05s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes shelf-rise {
    from { transform: translateY(1.25rem); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  .shelf-label {
    display: block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .shelf-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.15rem 1rem;
    margin-top: 1.25rem;
  }
  .shelf-item {
    flex: 0 0 calc(33.333% - 0.7rem);
    display: flex;
    animation: shelf-rise 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(0.25s + var(--i) * 0.07s);
  }
  /* each icon jumps to its own product card */
  .shelf-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    padding-block: 0.25rem;
    border-radius: 14px;
    text-decoration: none;
  }
  .shelf-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .shelf-link img {
    width: 3.85rem;
    height: 3.85rem;
    border-radius: 22.5%;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--brand) 22%, transparent),
      var(--shadow-sm);
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.25s ease;
  }
  .shelf-link:hover img,
  .shelf-link:focus-visible img {
    transform: translateY(-5px) scale(1.04);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--brand) 45%, transparent),
      var(--shadow-card);
  }
  .shelf-link:active img {
    transform: translateY(-1px) scale(1);
  }
  .shelf-name {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-ink);
    transition: color 0.15s ease;
  }
  .shelf-link:hover .shelf-name {
    color: var(--color-accent-ink);
  }
  .shelf-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.83rem;
    font-weight: 700;
    color: var(--color-accent-ink);
    text-decoration: none;
  }
  .shelf-arrow {
    transition: transform 0.2s ease;
  }
  .shelf-cta:hover .shelf-arrow {
    transform: translateX(4px);
  }

  /* ----- scroll cue ----- */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }
  .scroll-cue:hover {
    color: var(--color-accent-ink);
  }
  .scroll-word {
    font-family: var(--font-display);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    text-transform: uppercase;
  }
  .scroll-line {
    position: relative;
    width: 1px;
    height: 2.5rem;
    background: color-mix(in srgb, var(--color-muted) 35%, transparent);
    overflow: hidden;
  }
  .scroll-line::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 45%;
    background: var(--color-accent);
    animation: scroll-trail 2.2s ease-in-out infinite;
  }
  @keyframes scroll-trail {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(250%); }
  }

  /* ----- about ----- */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 2.5rem;
  }
  .about-body p + p {
    margin-top: 1.1rem;
  }
  .about-body strong {
    color: var(--color-ink);
  }

  /* ----- projects ----- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .project-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 5.5rem;
  }
  /* highlight the card the visitor jumped to from the hero shelf */
  .project-card:target {
    box-shadow:
      0 0 0 2px var(--brand),
      var(--shadow-card-hover);
  }
  .project-top {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 1rem;
  }
  .project-icon {
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    border-radius: 22.5%;
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--brand) 20%, transparent),
      var(--shadow-sm);
  }
  .project-dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--brand);
  }
  .project-headings {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .project-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1.1;
  }
  .project-tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-muted);
  }
  .project-desc {
    font-size: 0.92rem;
    color: var(--color-body);
    flex: 1;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .plink {
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: box-shadow 0.2s ease, color 0.15s ease, transform 0.15s ease;
  }
  .plink:hover {
    color: var(--color-accent-ink);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
  }
  .plink:active {
    transform: translateY(0);
    box-shadow: var(--shadow-pressed-sm);
  }
  .plink-primary {
    background: var(--color-panel);
    color: var(--color-on-panel);
  }
  .plink-primary:hover {
    color: var(--color-on-panel);
  }
  .plink-soon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: transparent;
    color: var(--color-muted);
    box-shadow: none;
    border: 1px dashed var(--color-border, #d4d8e0);
    cursor: default;
  }
  .plink-soon:hover {
    color: var(--color-muted);
    transform: none;
    box-shadow: none;
  }
  .soon-tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    background: var(--color-mist);
    color: var(--color-accent-ink);
  }

  /* ----- articles ----- */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  /* ----- profile ----- */
  .profile-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 2.5rem;
    align-items: center;
  }
  .profile-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.75rem;
  }
  .profile-avatar {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow: var(--shadow-pressed-sm);
    flex-shrink: 0;
    overflow: hidden;
  }
  .profile-avatar img {
    /* 写真なので円形の枠いっぱいに敷く（マーク画像だった頃は 58% で余白を作っていた） */
    width: 100%;
