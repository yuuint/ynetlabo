---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { PROJECTS, PROFILE, SITE, SOCIAL } from "../consts";
import { articleHref } from "../utils";
import { APP_DETAILS } from "../data/apps";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// noindex の記事は記事一覧とカテゴリにだけ出し、新着・関連の枠には出さない
const latest = posts.filter((p) => !p.data.noindex).slice(0, 3);

const origin = (Astro.site ?? new URL(SITE.url)).origin;

/** Anchor id for a product card, e.g. "wa/ri" -> "app-wa-ri" */
const appAnchor = (name: string) =>
  `app-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "")}`;

/**
 * ヒーローの「そぎ落とす」動き。5列×4行のマス目のうち、上3行は消えていく部品、
 * 4行目が残るアプリ。各アプリは KEEP_ROW の行から 4 行目へ降りてくる。
 * 部品の消える順は (n * 7) % 13 で散らす。
 */
const KEEP_ROW = [1, 0, 2, 1, 0];
type SiftCell = { kind: "bit"; i: number } | { kind: "gap" };
const siftCells: SiftCell[] = [];
let bitNo = 0;
for (let r = 0; r < 3; r++) {
  for (let c = 0; c < 5; c++) {
    siftCells.push(
      KEEP_ROW[c] === r ? { kind: "gap" } : { kind: "bit", i: (bitNo++ * 7) % 13 }
    );
  }
}
const siftApps = PROJECTS.slice(0, 5);
/**
 * 狭い画面用の1列版。9つの枠のうち PICK_SLOT の5つがアプリになり、
 * 残り（LINE_BITS）は消える。高さはアイコン1段ぶんだけで、動いても下がずれない。
 */
const PICK_SLOT = [0, 2, 5, 6, 8];
const LINE_BITS = [1, 3, 4, 7];

/** アプリ紹介ページ（/apps/<slug>）への内部リンク */
const appPageHref = (name: string) => {
  const d = APP_DETAILS.find((a) => a.project === name);
  return d ? `/apps/${d.slug}/` : undefined;
};

const appLd = PROJECTS.map((p) => ({
  "@type": "SoftwareApplication",
  name: p.name,
  description: p.description,
  applicationCategory: "MobileApplication",
  operatingSystem:
    [p.appStore && "iOS", p.googlePlay && "Android", p.site && "Web"]
      .filter(Boolean)
      .join(", ") || "Web",
  url: appPageHref(p.name) ? `${origin}${appPageHref(p.name)}` : p.site,
  sameAs: [p.site, p.appStore, p.googlePlay].filter(Boolean),
  offers: { "@type": "Offer", price: "0", priceCurrency: "JPY" },
  publisher: { "@id": `${origin}/#org` },
}));
---

<BaseLayout jsonLd={appLd}>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-panel">
        <div class="hero-copy">
          <h1 class="hero-title"><span>必要な機能だけを、</span><span>丁寧に。</span></h1>
          <p class="hero-lead" lang="en">{SITE.taglineEn}</p>
          <p class="hero-desc">{SITE.description}</p>
          <p class="hero-reach">
            iOS・Android・Web・LINE で使える {PROJECTS.length} つのアプリを、ひとりで作っています。
          </p>
          <div class="hero-actions">
            <a href="#projects" class="btn btn-accent">アプリを見る</a>
            <a href="/article/" class="btn btn-ghost">記事を読む</a>
          </div>
        </div>

        <div class="hero-art">
        <nav class="sift" aria-label="つくったアプリ">
          {
            siftCells.map((cell) =>
              cell.kind === "bit" ? (
                <span class="sift-bit" style={`--i:${cell.i}`} aria-hidden="true" />
              ) : (
                <span class="sift-gap" aria-hidden="true" />
              )
            )
          }
          {
            LINE_BITS.map((j, n) => (
              <span class="line-bit" style={`--j:${j};--n:${n}`} aria-hidden="true" />
            ))
          }
          {
            siftApps.map((p, c) => (
              <a
                class="pick"
                href={`#${appAnchor(p.name)}`}
                style={`--r:${KEEP_ROW[c]};--c:${c};--j:${PICK_SLOT[c]};--brand:${p.accent}`}
                aria-label={`${p.name}（${p.tagline}）`}
              >
                <span class="pick-icon">
                  <img src={p.icon} alt="" width="72" height="72" decoding="async" />
                </span>
                <span class="pick-name">{p.name}</span>
              </a>
            ))
          }
        </nav>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about" class="section">
    <div class="wrap about-grid">
      <div>
        <span class="eyebrow" lang="en">About</span>
        <h2 class="section-title">「これで十分」と思える道具を。</h2>
      </div>
      <div class="about-body">
        <p>
          Y.NetLabo は、企業ではなく「アプリ開発が好きな個人」のラボです。多機能で複雑なものより、<strong
            >迷わず使えるシンプルなアプリ</strong
          >を目指しています。
        </p>
        <p>
          不要な機能はそぎ落とし、本当に必要な機能だけを残す。そこに、ちょっとした遊び心としてペンギンのモチーフを添えています。使う人が「これで十分」と思える道具を作ることが、このラボのテーマです。
        </p>
      </div>
    </div>
  </section>

  <!-- ============ PROJECTS ============ -->
  <section id="projects" class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow" lang="en">Apps</span>
        <h2 class="section-title">つくったアプリ</h2>
        <p class="section-sub">個人開発で世に出してきたアプリたち。</p>
      </div>

      <div class="project-grid">
        {
          PROJECTS.map((p) => (
            <article
              class="card project-card"
              id={appAnchor(p.name)}
              style={`--brand:${p.accent}`}
            >
              <div class="project-top">
                {p.icon ? (
                  <img
                    class="project-icon"
                    src={p.icon}
                    alt={`${p.name} アプリアイコン`}
                    width="56"
                    height="56"
                    loading="lazy"
                  />
                ) : (
                  <span class="project-dot" />
                )}
                <div class="project-headings">
                  <h3 class="project-name">{p.name}</h3>
                  <span class="project-tag">{p.tagline}</span>
                </div>
              </div>
              <p class="project-desc">{p.description}</p>
              <div class="project-links">
                {appPageHref(p.name) && (
                  <a class="plink plink-primary" href={appPageHref(p.name)}>
                    詳しく見る
                  </a>
                )}
                {p.site && (
                  <a class="plink" href={p.site} target="_blank" rel="noopener noreferrer">
                    公式サイト
                  </a>
                )}
                {p.appStore && (
                  <a class="plink" href={p.appStore} target="_blank" rel="noopener noreferrer">
                    App Store
                  </a>
                )}
                {p.googlePlay && (
                  <a class="plink" href={p.googlePlay} target="_blank" rel="noopener noreferrer">
                    Google Play
                  </a>
                )}
                {p.comingSoon?.map((store) => (
                  <span class="plink plink-soon" aria-disabled="true">
                    {store}
                    <span class="soon-tag">近日公開</span>
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LATEST ARTICLES ============ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head row">
        <div>
          <span class="eyebrow" lang="en">Notes</span>
          <h2 class="section-title">最新の記事</h2>
        </div>
        <a href="/article/" class="btn btn-ghost link-all">すべての記事</a>
      </div>

      <div class="article-grid">
        {
          latest.map((post) => (
            <ArticleCard
              href={articleHref(post.data.wpId)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              categories={post.data.categories}
              heroImage={post.data.heroImage}
              heroAlt={post.data.heroAlt}
              wpId={post.data.wpId}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ PROFILE ============ -->
  <section class="section">
    <div class="wrap">
      <div class="profile-panel card">
        <div class="profile-id">
          <div class="profile-avatar">
            <img src={PROFILE.avatar} alt="" width="460" height="460" loading="lazy" />
          </div>
          <div>
            <p class="profile-name">{PROFILE.name}</p>
            <p class="profile-role" lang="en">{PROFILE.role}</p>
          </div>
        </div>
        <div class="profile-body">
          <span class="eyebrow" lang="en">Profile</span>
          <h2 class="section-title">つくっている人</h2>
          <p>{PROFILE.bio}</p>
          <div class="stack">
            {PROFILE.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
          <div class="profile-social">
            <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">GitHub</a>
            <a href={SOCIAL.x} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">X (Twitter)</a>
            <a href={SOCIAL.qiita} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Qiita</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT CTA ============ -->
  <section class="section section-tight">
    <div class="wrap">
      <div class="cta">
        <h2 class="cta-title">ご感想やご要望をお聞かせください</h2>
        <p class="cta-sub">
          アプリへのご感想・ご要望、不具合のご報告などお待ちしています。
        </p>
        <div class="cta-actions">
          <a href="/contact/" class="btn cta-primary">お問い合わせ</a>
          <a href={`mailto:${SITE.email}`} class="btn cta-ghost">{SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ----- section primitives ----- */
  .section {
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 5.5rem);
    /* アンカーで飛んだとき sticky ヘッダーに隠れないように */
    scroll-margin-top: 4.75rem;
  }
  .section-tight {
    padding-bottom: 0;
  }
  .section-head {
    margin-bottom: 2.25rem;
  }
  .section-head.row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .section-title {
    font-size: clamp(1.45rem, 1.15rem + 1.3vw, 2rem);
    margin-top: 0.7rem;
  }
  .section-sub {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
  .link-all {
    padding: 0.55rem 1.2rem;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  /* ----- hero ----- */
  .hero {
    padding-top: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
  }
  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    background: var(--color-paper);
    border-radius: clamp(28px, 1rem + 2vw, 40px);
    padding: clamp(2rem, 1rem + 4vw, 4.5rem);
  }
  .hero-title {
    font-size: clamp(1.3rem, 0.8rem + 2.9vw, 3.1rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.06em;
  }
  /* 1行ずつ塊にして、句の途中で折り返さないようにする */
  .hero-title span {
    display: inline-block;
  }
  .hero-lead {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1rem, 0.9rem + 0.4vw, 1.2rem);
    letter-spacing: 0.01em;
    color: var(--color-muted);
    margin-top: 0.9rem;
    animation: fade-in 0.8s 2.3s ease both;
  }
  .hero-desc {
    margin-top: 1.5rem;
    max-width: 34rem;
  }
  .hero-reach {
    margin-top: 0.5rem;
    max-width: 34rem;
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  /*
   * ----- hero art: そぎ落とす -----
   * 灰色の部品が消え、残った 5 つが最下段へ降りてアプリのアイコンになる。
   * アプリは DOM 上は最下段にあり、上の行から「戻ってくる」動きにしているので、
   * 動きを切ってもそのまま完成形になる。
   */
  .sift {
    --cell: clamp(2.75rem, 1.6rem + 3.6vw, 5rem);
    --gap: clamp(0.55rem, 0.3rem + 0.8vw, 1rem);
    display: grid;
    grid-template-columns: repeat(5, var(--cell));
    grid-template-rows: repeat(3, var(--cell)) auto;
    gap: var(--gap);
    justify-content: center;
  }
  /* 消えた部品は、点線の枠だけを跡として残す */
  .sift-bit {
    border-radius: 26%;
    background: var(--color-line);
    border: 1px dashed transparent;
    animation: bit-out 0.6s cubic-bezier(0.4, 0, 0.2, 1) both;
    animation-delay: calc(0.35s + var(--i) * 45ms);
  }
  .sift-gap {
    visibility: hidden;
  }
  /* 1列版の部品は狭い画面でだけ使う */
  .line-bit {
    display: none;
  }
  .pick {
    --dy: calc((3 - var(--r)) * (var(--cell) + var(--gap)) * -1);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    border-radius: 18px;
    animation: pick-drop 2.1s cubic-bezier(0.65, 0, 0.35, 1) both;
  }
  .pick-icon {
    position: relative;
    display: block;
    width: var(--cell);
    height: var(--cell);
    border-radius: 26%;
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pick-icon img {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* 動き出すまでは他の部品と同じ灰色。動きながらアイコンに変わる */
  .pick-icon::after {
    content: "";
    position: absolute;
    inset: -1px;
    background: var(--color-line);
    animation: pick-reveal 2.6s ease both;
    pointer-events: none;
  }
  .pick-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(0.72rem, 0.65rem + 0.25vw, 0.88rem);
    line-height: 1;
    color: var(--color-ink);
    white-space: nowrap;
    animation: fade-in 0.6s 2.2s ease both;
  }
  .pick:hover .pick-icon {
    transform: translateY(-4px);
  }
  @keyframes bit-out {
    to {
      background: transparent;
      border-color: var(--color-line-strong);
      transform: scale(0.78);
    }
  }
  @keyframes pick-drop {
    0%, 38% {
      transform: translateY(var(--dy));
    }
    82%, 100% {
      transform: none;
    }
  }
  /*
   * 灰色の覆いは、動き始め（全体の約 0.85 秒）から溶かし始め、移動・拡大の途中で
   * アイコンが見えるようにする。着地する前にはすっかりアイコンになっている。
   */
  @keyframes pick-reveal {
    0%, 32% {
      opacity: 1;
    }
    62%, 100% {
      opacity: 0;
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ----- about ----- */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem;
    align-items: start;
  }
  .about-body p + p {
    margin-top: 1.1rem;
  }
  .about-body strong {
    color: var(--color-ink);
    font-weight: 700;
  }

  /* ----- projects ----- */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .project-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    scroll-margin-top: 5.5rem;
  }
  /* ヒーローのアイコンから飛んできたカードを、アプリの色の線で示す */
  .project-card:target {
    box-shadow: inset 0 0 0 2px var(--brand);
  }
  .project-top {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }
  .project-icon {
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    border-radius: 26%;
  }
  .project-dot {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--brand);
  }
  .project-headings {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }
  .project-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: 0;
  }
  .project-tag {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .project-desc {
    font-size: 0.92rem;
    flex: 1;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
  }
  .plink {
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    color: var(--color-ink);
    text-decoration: none;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    transition: box-shadow 0.2s ease, background-color 0.2s ease;
  }
  .plink:hover {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }
  .plink-primary {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: none;
  }
  .plink-primary:hover {
    background: var(--color-ink-soft);
    box-shadow: none;
  }
  .plink-soon {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-muted);
    box-shadow: inset 0 0 0 1px var(--color-line);
    cursor: default;
  }
  .plink-soon:hover {
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .soon-tag {
    font-size: 0.68rem;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: var(--color-mist);
    color: var(--color-accent-ink);
  }

  /* ----- articles ----- */
  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  /* ----- profile ----- */
  .profile-panel {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 2.5rem;
    align-items: start;
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
  }
  .profile-id {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }
  .profile-avatar {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--color-mist);
  }
  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .profile-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--color-ink);
  }
  .profile-role {
    font-family: var(--font-display);
    font-weight: 300;
    color: var(--color-muted);
    font-size: 0.95rem;
    margin-top: 0.3rem;
  }
  .profile-body p {
    margin-top: 1rem;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.25rem;
  }
  .profile-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 1.75rem;
    flex-wrap: wrap;
  }
  .profile-social .btn {
    padding: 0.55rem 1.2rem;
    font-size: 0.88rem;
  }

  /* ----- CTA ----- */
  .cta {
    background: var(--color-paper);
    border-radius: clamp(28px, 1rem + 2vw, 40px);
    padding: clamp(2.5rem, 1.5rem + 4vw, 4rem) clamp(1.5rem, 1rem + 3vw, 4rem);
    text-align: center;
  }
  .cta-title {
    font-size: clamp(1.35rem, 1.1rem + 1.2vw, 1.9rem);
  }
  .cta-sub {
    color: var(--color-muted);
    margin-top: 0.75rem;
  }
  .cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  .cta-primary {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .cta-primary:hover {
    background: var(--color-accent-soft);
  }
  .cta-ghost {
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    overflow-wrap: anywhere;
  }
  .cta-ghost:hover {
    box-shadow: inset 0 0 0 1px var(--color-ink);
  }

  /* ----- responsive ----- */
  @media (max-width: 960px) {
    .project-grid,
    .article-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /*
   * 縦に積む画面（スマホ縦・タブレット）：見出し → アイコン → 説明 → ボタン。
